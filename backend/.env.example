PORT=8080

# OpenAI Realtime Translation + Responses API
OPENAI_API_KEY=
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
TEXT_TRANSLATION_MODEL=gpt-5.6-luna
SUMMARY_MODEL=gpt-5.6-terra

# Firebase / Google Cloud
PROJECT_ID=internation-conference-helper
FIRESTORE_DATABASE_ID=user
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
ADMIN_EMAILS=
TRIAL_DAYS=5

# Comma-separated web origins. Do not use * in production.
ALLOWED_ORIGINS=https://waterfirst.github.io,http://localhost:5500,http://127.0.0.1:5500

# Toss Payments server secret. Never put this value in frontend files.
TOSS_SECRET_KEY=
